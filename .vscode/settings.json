{
    "[javascript][typescript]": {
        "editor.autoIndent": "full",
        "editor.trimAutoWhitespace": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    "js/ts.preferences.quoteStyle": "single",
    "js/ts.format.semicolons": "remove",
    "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
    "js/ts.preferences.importModuleSpecifier": "relative",
    "cSpell.words": [
        "Bootstrapper",
        "cobertura",
        "datareader",
        "datawriter",
        "datdba",
        "datname",
        "dbmigrationsexample",
        "msdb",
        "NOCREATEDB",
        "NOCREATEROLE",
        "NOREPLICATION",
        "NOSUPERUSER",
        "nupkg",
        "reportgenerator",
        "reporttypes",
        "rolname",
        "sqlserver",
        "targetdir",
        "tempdb"
    ],
    "dotnet.defaultSolution": "db-migrations-dotnet.sln"
}
